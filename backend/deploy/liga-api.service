# systemd unit para el backend en el VPS vía docker-compose.
# Reinicia el servicio automáticamente si se cae (alta disponibilidad básica).
# Instalar en /etc/systemd/system/liga-api.service y:
#   systemctl daemon-reload && systemctl enable --now liga-api
[Unit]
Description=Liga Verano Alameda API
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/liga/backend          # <-- ruta del repo en el VPS
ExecStart=/usr/bin/docker compose up
ExecStop=/usr/bin/docker compose down
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
